{
  "version": "0.1.3",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json",
    "test:ts:back": "tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "@strapi/sdk-plugin": "^6.1.0",
    "@strapi/strapi": "^5.47.0",
    "@strapi/typescript-utils": "^5.47.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.4",
    "styled-components": "^6.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.0",
    "@strapi/icons": "^2.2.0",
    "@strapi/sdk-plugin": "^6.1.0",
    "@strapi/strapi": "^5.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.6.0",
    "react-router-dom": "^6.30.4",
    "styled-components": "^6.4.2"
  },
  "strapi": {
    "kind": "plugin",
    "name": "conditional-field-builder",
    "displayName": "Conditional Field Builder",
    "description": "A dropdown whose selected option renders dynamic conditional sub-fields, stored as a single JSON value."
  },
  "name": "strapi-plugin-conditional-field-builder",
  "description": "Strapi v5 custom field: pick an option, get a tailored set of sub-fields. An embedded form-builder, stored as a single JSON value.",
  "keywords": [
    "strapi",
    "plugin",
    "strapi-plugin",
    "strapi-custom-field",
    "conditional",
    "dropdown",
    "form-builder",
    "variant"
  ],
  "license": "MIT",
  "author": "AhmadAl-Ghalban <ahmadalghalban05@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmadAl-Ghalban/strapi-plugin-conditional-field-builder.git"
  },
  "bugs": {
    "url": "https://github.com/AhmadAl-Ghalban/strapi-plugin-conditional-field-builder/issues"
  },
  "homepage": "https://github.com/AhmadAl-Ghalban/strapi-plugin-conditional-field-builder#readme"
}
